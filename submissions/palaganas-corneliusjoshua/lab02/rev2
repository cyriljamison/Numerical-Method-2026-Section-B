    # Calculate DOF statistics
    total_dof = len(model.nodes) * 6
    restrained_dof = len(model.supports) * 3  # UX, UY, UZ for each pinned support
    active_dof = total_dof - restrained_dof
    
    # Get pinned member numbers (1-based)
    pinned_members = sorted([m + 1 for m in model.releases.keys()])
    
    text = "MODEL DATA - REV. 2\n"
    text += "="*40 + "\n\n"
    
    text += "Geometry\n"
    text += "    Cube edge    6.0 m\n"
    text += f"    Nodes        {len(model.nodes)}\n"
    text += f"    Members      {len(model.members)}\n\n"
    
    text += "Global axes\n"
    text += "    X    lateral\n"
    text += "    Y    vertical (up)\n"
    text += "    Z    lateral\n\n"
    
    text += "Supports\n"
    text += "    Type    pinned\n"
    text += "    Nodes    1, 2, 3, 4\n"
    text += "    Restrained    UX, UY, UZ\n"
    text += "    Released    RX, RY, RZ\n\n"
    
    text += "Nodal degrees of freedom\n"
    text += "    DOF per node    6\n"
    text += f"    Total DOF      {total_dof}\n"
    text += f"    Restrained DOF {restrained_dof}\n"
    text += f"    Active DOF     {active_dof}\n"
    text += "    Numbering    (node - 1) x 6 + 1..6\n\n"
    
    text += "Member end releases\n"
    text += f"    Pinned members    {', '.join(map(str, pinned_members))}\n"
    text += "    Pattern    Pinned i and j\n"
    text += "    Component    MZ, moment about local z\n"
    text += "    Released end DOF    8\n"
    text += "    Member end DOF    144 (12 per member)\n"
    text += "    Symbol    hollow circle at the end\n\n"
    
    text += "Beta angles\n"
    text += "    Base Beam    0 deg\n"
    text += "    Roof Beam    0 deg\n"
    text += "    Column    90 deg\n\n"
    
    text += "Local axes\n"
    text += "    local x    start node i to end node j\n"
    text += "    local y    in the vertical plane, upward\n"
    text += "    local z    completes the right-handed set\n"
    text += "    Vertical members follow the limiting\n"
    text += "    case: local z parallel to global Z."
    
    return text

def draw_pinned_support(ax, node):
    """Draw a pinned support symbol (triangle) at a node"""
    size = 0.4
    x, y, z = node
    # Draw triangle in the XY plane
    triangle = np.array([
        [x, y - size, z],
        [x - size/2, y, z],
        [x + size/2, y, z]
    ])
    ax.plot_trisurf(triangle[:, 0], triangle[:, 1], triangle[:, 2],
                   color='green', alpha=0.6)
    # Add a small circle at the vertex
    ax.scatter(x, y - size, z, color='darkgreen', s=30)

def draw_pinned_symbol(ax, node, adjacent_node, position):
    """Draw a circle symbol for pinned/released end"""
    # Direction vector from node to adjacent node
    dx = adjacent_node[0] - node[0]
    dy = adjacent_node[1] - node[1]
    dz = adjacent_node[2] - node[2]
    length = sqrt(dx**2 + dy**2 + dz**2)
    
    if length == 0:
        return
    
    # Normalize and offset from node
    offset = 0.4
    x = node[0] + (dx/length) * offset
    y = node[1] + (dy/length) * offset
    z = node[2] + (dz/length) * offset
    
    # Draw a small circle (pinned symbol)
    u = np.linspace(0, 2 * np.pi, 20)
    v = np.linspace(0, np.pi, 20)
    r = 0.2
    x_circle = x + r * np.outer(np.cos(u), np.sin(v))
    y_circle = y + r * np.outer(np.sin(u), np.sin(v))
    z_circle = z + r * np.outer(np.ones(np.size(u)), np.cos(v))
    ax.plot_surface(x_circle, y_circle, z_circle, color='orange', alpha=0.8)

def draw_local_axes(ax, start, end, beta_angle):
    """Draw local axes for a member"""
    # Calculate member direction vector
    dx = end[0] - start[0]
    dy = end[1] - start[1]
    dz = end[2] - start[2]
    length = sqrt(dx**2 + dy**2 + dz**2)
    
    if length == 0:
        return
    
    # Midpoint of member
    mid = [(start[0] + end[0]) / 2, (start[1] + end[1]) / 2, (start[2] + end[2]) / 2]
    
    # Local x-axis (along member)
    lx = [dx/length, dy/length, dz/length]
    
    # Local y-axis (perpendicular to x, in global vertical plane)
    # Use global Y as reference for vertical
    global_y = [0, 1, 0]
    # Cross product of global_y and lx gives lz
    lz = np.cross(global_y, lx)
    if np.linalg.norm(lz) < 0.001:
        # If member is vertical, use global Z as reference
        global_z = [0, 0, 1]
        lz = np.cross(global_z, lx)
    lz = lz / np.linalg.norm(lz)
    
    # Local y-axis = lz x lx
    ly = np.cross(lz, lx)
    ly = ly / np.linalg.norm(ly)
    
    # Apply beta angle rotation (about lx)
    beta_rad = np.radians(beta_angle)
    # Rotate ly and lz about lx by beta_angle
    ly_rot = ly * np.cos(beta_rad) + np.cross(lx, ly) * np.sin(beta_rad)
    lz_rot = lz * np.cos(beta_rad) + np.cross(lx, lz) * np.sin(beta_rad)
    
    # Scale for visualization
    scale = 0.6
    
    # Draw local axes
    # x-axis (red)
    ax.quiver(mid[0], mid[1], mid[2], 
             lx[0]*scale, lx[1]*scale, lx[2]*scale,
             color='red', linewidth=2.5, arrow_length_ratio=0.2)
    ax.text(mid[0] + lx[0]*scale*1.1, mid[1] + lx[1]*scale*1.1, 
            mid[2] + lx[2]*scale*1.1, 'x', color='red', fontsize=8, weight='bold')
    
    # y-axis (green)
    ax.quiver(mid[0], mid[1], mid[2],
             ly_rot[0]*scale, ly_rot[1]*scale, ly_rot[2]*scale,
             color='green', linewidth=2.5, arrow_length_ratio=0.2)
    ax.text(mid[0] + ly_rot[0]*scale*1.1, mid[1] + ly_rot[1]*scale*1.1, 
            mid[2] + ly_rot[2]*scale*1.1, 'y', color='green', fontsize=8, weight='bold')
    
    # z-axis (blue)
    ax.quiver(mid[0], mid[1], mid[2],
             lz_rot[0]*scale, lz_rot[1]*scale, lz_rot[2]*scale,
             color='blue', linewidth=2.5, arrow_length_ratio=0.2)
    ax.text(mid[0] + lz_rot[0]*scale*1.1, mid[1] + lz_rot[1]*scale*1.1, 
            mid[2] + lz_rot[2]*scale*1.1, 'z', color='blue', fontsize=8, weight='bold')

def draw_global_axes(ax):
    """Draw global axes at origin"""
    # Global axes at origin
    origin = [0, 0, 0]
    axis_length = 2.0
    
    # X-axis (red)
    ax.quiver(origin[0], origin[1], origin[2], 
             axis_length, 0, 0,
             color='red', linewidth=3, arrow_length_ratio=0.15)
    ax.text(axis_length + 0.3, 0, 0, 'Global X', color='red', 
           fontsize=10, weight='bold')
    
    # Y-axis (green) - vertical
    ax.quiver(origin[0], origin[1], origin[2],
             0, axis_length, 0,
             color='green', linewidth=3, arrow_length_ratio=0.15)
    ax.text(0, axis_length + 0.3, 0, 'Global Y', color='green', 
           fontsize=10, weight='bold')
    
    # Z-axis (blue)
    ax.quiver(origin[0], origin[1], origin[2],
             0, 0, axis_length,
             color='blue', linewidth=3, arrow_length_ratio=0.15)
    ax.text(0, 0, axis_length + 0.3, 'Global Z', color='blue', 
           fontsize=10, weight='bold')

def print_model_summary(model):
    """Print detailed model summary"""
    print("\n" + "="*80)
    print("STRUCTURAL MODEL SUMMARY - 6m x 6m x 6m CUBE (Rev. 2)")
    print("="*80)
    
    # Calculate DOF statistics
    total_dof = len(model.nodes) * 6
    restrained_dof = len(model.supports) * 3
    active_dof = total_dof - restrained_dof
    
    print("\n📊 MODEL PROPERTIES:")
    print(f"  • Cube Edge: 6.0 m")
    print(f"  • Total Nodes: {len(model.nodes)}")
    print(f"  • Total Members: {len(model.members)}")
    print(f"  • DOF per Node: 6")
    print(f"  • Total DOF: {total_dof}")
    print(f"  • Restrained DOF: {restrained_dof}")
    print(f"  • Active DOF: {active_dof}")
    print(f"  • Pinned Supports: {len(model.supports)} (Nodes 1-4)")
    print(f"  • Members with MZ Releases: {len(model.releases)}")
    print(f"  • Release Type: Moment about Z-axis (MZ) at both ends")
    
    print("\n📋 NODE SUMMARY WITH DOF:")
    print("  Node |  X (m)  |  Y (m)  |  Z (m)  | Support | DOF Range")
    print("  " + "-"*70)
    for i, node in enumerate(model.nodes):
        support = "Pinned" if i in model.supports else "Free"
        dof_start = model.dof_labels[i]['UX']
        dof_end = model.dof_labels[i]['RZ']
        print(f"  N{i+1:<2}  | {node[0]:6.1f}  | {node[1]:6.1f}  | {node[2]:6.1f}  | {support:6} | {dof_start:2} - {dof_end:2}")
    
    print("\n📐 MEMBER SUMMARY:")
    print("  Member | Start | End | Length | Beta° | Orientation | Releases")
    print("  " + "-"*80)
    for i, member in enumerate(model.members):
        start = member[0]
        end = member[1]
        start_node = model.nodes[start]
        end_node = model.nodes[end]
        length = sqrt(sum((end_node[j] - start_node[j])**2 for j in range(3)))
        releases = model.releases.get(i, {})
        start_rel = ', '.join(releases.get('start', ['None']))
        end_rel = ', '.join(releases.get('end', ['None']))
        
        # Determine orientation
        if start_node[0] == end_node[0] and start_node[2] == end_node[2]:
            orient = 'Column'
        elif start_node[1] == end_node[1]:
            orient = 'Beam'
        else:
            orient = 'Diagonal'
        
        rel_str = f"S:{start_rel} E:{end_rel}" if start_rel != 'None' else 'Fixed'
        print(f"  M{i+1:<2}  |  N{start+1}   |  N{end+1}  | {length:6.2f} | {model.beta_angles[i]:6.1f} | {orient:8} | {rel_str}")
    
    print("\n" + "="*80)

