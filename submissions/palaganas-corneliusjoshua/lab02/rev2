"""
STRUCTURAL MODEL - 6m x 6m x 6m CUBE (Rev. 2)
Enhanced with:
- Pinned supports at bottom nodes (N0-N3)
- DOF labels for each node (6 DOF per node)
- MZ end releases on X-direction beams
- Beta angles for members (90° for vertical members)
- Global and local axes visualization
- Model data displayed as text on the side
- Comprehensive Excel output
"""

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D
from mpl_toolkits.mplot3d.art3d import Poly3DCollection
import os
from math import atan2, degrees, sqrt, radians, cos, sin

class StructuralModel:
    def __init__(self):
        self.nodes = []
        self.members = []
        self.supports = {}
        self.releases = {}
        self.beta_angles = {}
        self.dof = {}
        self.node_labels = {}
        self.dof_labels = {}
        
    def create_cube(self):
        """Create a 6m x 6m x 6m cube with all structural properties"""
        
        # Define nodes (X, Y, Z) where Y is vertical
        # Nodes 1-4 are pinned (1-based indexing in the diagram)
        self.nodes = [
            [0, 0, 0],     # Node 0 (Node 1 in 1-based) - bottom-front-left - Pinned
            [6, 0, 0],     # Node 1 (Node 2 in 1-based) - bottom-front-right - Pinned
            [6, 0, 6],     # Node 2 (Node 3 in 1-based) - bottom-back-right - Pinned
            [0, 0, 6],     # Node 3 (Node 4 in 1-based) - bottom-back-left - Pinned
            [0, 6, 0],     # Node 4 (Node 5 in 1-based) - top-front-left
            [6, 6, 0],     # Node 5 (Node 6 in 1-based) - top-front-right
            [6, 6, 6],     # Node 6 (Node 7 in 1-based) - top-back-right
            [0, 6, 6]      # Node 7 (Node 8 in 1-based) - top-back-left
        ]
        
        # Member incidences: [start_node, end_node]
        # Using 0-based indexing internally, but display as 1-based
        self.members = [
            [0, 1],  # M0 (M1 in 1-based) - Bottom-front (X-direction) - Released
            [1, 2],  # M1 (M2 in 1-based) - Bottom-right (Z-direction)
            [2, 3],  # M2 (M3 in 1-based) - Bottom-back (X-direction) - Released
            [3, 0],  # M3 (M4 in 1-based) - Bottom-left (Z-direction)
            [4, 5],  # M4 (M5 in 1-based) - Top-front (X-direction) - Released
            [5, 6],  # M5 (M6 in 1-based) - Top-right (Z-direction)
            [6, 7],  # M6 (M7 in 1-based) - Top-back (X-direction) - Released
            [7, 4],  # M7 (M8 in 1-based) - Top-left (Z-direction)
            [0, 4],  # M8 (M9 in 1-based) - Front-left vertical (Column) - Beta=90°
            [1, 5],  # M9 (M10 in 1-based) - Front-right vertical (Column) - Beta=90°
            [2, 6],  # M10 (M11 in 1-based) - Back-right vertical (Column) - Beta=90°
            [3, 7]   # M11 (M12 in 1-based) - Back-left vertical (Column) - Beta=90°
        ]
        
        # Define pinned supports at bottom nodes (Nodes 1-4 in 1-based = 0-3 in 0-based)
        # Pinned: Restrain X, Y, Z translations
        self.supports = {
            0: {'type': 'Pinned', 'restraints': ['UX', 'UY', 'UZ']},
            1: {'type': 'Pinned', 'restraints': ['UX', 'UY', 'UZ']},
            2: {'type': 'Pinned', 'restraints': ['UX', 'UY', 'UZ']},
            3: {'type': 'Pinned', 'restraints': ['UX', 'UY', 'UZ']}
        }
        
        # Define beam releases (MZ end releases on X-direction beams)
        # Pinned members: 1, 3, 5, 7 (1-based) = 0, 2, 4, 6 (0-based)
        # Pattern: Pinned i and j (both ends)
        # Component: MZ (moment about local z)
        self.releases = {
            0: {'start': ['MZ'], 'end': ['MZ']},  # M1 - Bottom-front
            2: {'start': ['MZ'], 'end': ['MZ']},  # M3 - Bottom-back
            4: {'start': ['MZ'], 'end': ['MZ']},  # M5 - Top-front
            6: {'start': ['MZ'], 'end': ['MZ']}   # M7 - Top-back
        }
        
        # Define Beta angles
        # Base Beam: 0°, Roof Beam: 0°, Column: 90°
        for i in range(len(self.members)):
            start_node = self.members[i][0]
            end_node = self.members[i][1]
            # Check if member is vertical (column)
            if (self.nodes[start_node][0] == self.nodes[end_node][0] and 
                self.nodes[start_node][2] == self.nodes[end_node][2]):
                self.beta_angles[i] = 90.0  # Column
            else:
                self.beta_angles[i] = 0.0   # Beam
        
        # Calculate DOF for each node
        self.calculate_dof()
        
        # Generate DOF labels
        self.generate_dof_labels()
        
    def calculate_dof(self):
        """Calculate degrees of freedom for each node"""
        for i, node in enumerate(self.nodes):
            if i in self.supports:
                # Pinned support: only translations are restrained
                # DOF: UX, UY, UZ are fixed; RX, RY, RZ are free
                self.dof[i] = {
                    'UX': 'Fixed', 'UY': 'Fixed', 'UZ': 'Fixed',
                    'RX': 'Free', 'RY': 'Free', 'RZ': 'Free'
                }
            else:
                # Free node: all DOF are free
                self.dof[i] = {
                    'UX': 'Free', 'UY': 'Free', 'UZ': 'Free',
                    'RX': 'Free', 'RY': 'Free', 'RZ': 'Free'
                }
    
    def generate_dof_labels(self):
        """Generate DOF labels for each node (1-based numbering for DOF)"""
        # DOF per node: 6, Total DOF: 48
        # Numbering: (node - 1) x 6 + 1..6
        for i in range(len(self.nodes)):
            base = i * 6
            self.dof_labels[i] = {
                'UX': base + 1,
                'UY': base + 2,
                'UZ': base + 3,
                'RX': base + 4,
                'RY': base + 5,
                'RZ': base + 6
            }

def create_excel_file(model):
    """Create enhanced Excel file with all structural data"""
    
    # 1. Nodes DataFrame with DOF labels
    node_data = []
    for i, node in enumerate(model.nodes):
        dof_status = model.dof[i]
        dof_labels = model.dof_labels[i]
        support_type = model.supports.get(i, {}).get('type', 'None')
        node_data.append({
            'Node (1-based)': i + 1,
            'X (m)': node[0],
            'Y (m)': node[1],
            'Z (m)': node[2],
            'Support': support_type,
            'UX DOF': dof_labels['UX'],
            'UY DOF': dof_labels['UY'],
            'UZ DOF': dof_labels['UZ'],
            'RX DOF': dof_labels['RX'],
            'RY DOF': dof_labels['RY'],
            'RZ DOF': dof_labels['RZ'],
            'UX Status': dof_status['UX'],
            'UY Status': dof_status['UY'],
            'UZ Status': dof_status['UZ'],
            'RX Status': dof_status['RX'],
            'RY Status': dof_status['RY'],
            'RZ Status': dof_status['RZ']
        })
    node_df = pd.DataFrame(node_data)
    node_df.set_index('Node (1-based)', inplace=True)
    
    # 2. Members DataFrame
    member_data = []
    for i, member in enumerate(model.members):
        releases = model.releases.get(i, {})
        start_releases = ', '.join(releases.get('start', [])) if releases else 'None'
        end_releases = ', '.join(releases.get('end', [])) if releases else 'None'
        
        # Calculate member length and orientation
        start_node = model.nodes[member[0]]
        end_node = model.nodes[member[1]]
        length = sqrt(sum((end_node[j] - start_node[j])**2 for j in range(3)))
        
        # Determine member orientation
        if start_node[0] == end_node[0] and start_node[2] == end_node[2]:
            orientation = 'Column'
        elif start_node[1] == end_node[1]:
            orientation = 'Beam'
        else:
            orientation = 'Diagonal'
        
        member_data.append({
            'Member (1-based)': i + 1,
            'Start Node': member[0] + 1,
            'End Node': member[1] + 1,
            'Length (m)': round(length, 3),
            'Beta Angle (°)': model.beta_angles[i],
            'Orientation': orientation,
            'Start Releases': start_releases,
            'End Releases': end_releases
        })
    member_df = pd.DataFrame(member_data)
    member_df.set_index('Member (1-based)', inplace=True)
    
    # 3. Support Summary DataFrame
    support_data = []
    for node, support in model.supports.items():
        support_data.append({
            'Node (1-based)': node + 1,
            'Type': support['type'],
            'Restrained': ', '.join(support['restraints']),
            'Released': 'RX, RY, RZ'
        })
    support_df = pd.DataFrame(support_data)
    support_df.set_index('Node (1-based)', inplace=True)
    
    # 4. DOF Summary DataFrame
    dof_data = []
    for node, dof in model.dof.items():
        dof_labels = model.dof_labels[node]
        dof_data.append({
            'Node (1-based)': node + 1,
            'UX (DOF)': dof_labels['UX'],
            'UY (DOF)': dof_labels['UY'],
            'UZ (DOF)': dof_labels['UZ'],
            'RX (DOF)': dof_labels['RX'],
            'RY (DOF)': dof_labels['RY'],
            'RZ (DOF)': dof_labels['RZ'],
            'UX': dof['UX'],
            'UY': dof['UY'],
            'UZ': dof['UZ'],
            'RX': dof['RX'],
            'RY': dof['RY'],
            'RZ': dof['RZ']
        })
    dof_df = pd.DataFrame(dof_data)
    dof_df.set_index('Node (1-based)', inplace=True)
    
    # 5. Releases Summary
    release_data = []
    for member, releases in model.releases.items():
        release_data.append({
            'Member (1-based)': member + 1,
            'Start Node': model.members[member][0] + 1,
            'End Node': model.members[member][1] + 1,
            'Pattern': 'Pinned i and j',
            'Component': 'MZ',
            'Released End DOF': 8,
            'Member End DOF': 12
        })
    release_df = pd.DataFrame(release_data)
    release_df.set_index('Member (1-based)', inplace=True)
    
    # Save to Excel
    filename = 'cube_6m_PALAGANAS_Rev2.xlsx'
    with pd.ExcelWriter(filename, engine='openpyxl') as writer:
        node_df.to_excel(writer, sheet_name='Nodes')
        member_df.to_excel(writer, sheet_name='Members')
        support_df.to_excel(writer, sheet_name='Supports')
        dof_df.to_excel(writer, sheet_name='DOF_Summary')
        release_df.to_excel(writer, sheet_name='Releases')
        
        # Add a summary sheet with model data
        summary_data = {
            'Property': [
                'Cube edge', 'Nodes', 'Members',
                'Global X', 'Global Y', 'Global Z',
                'Support Type', 'Support Nodes', 'Restrained', 'Released',
                'DOF per node', 'Total DOF', 'Restrained DOF', 'Active DOF',
                'Numbering', 'Pinned members', 'Pattern', 'Component',
                'Released end DOF', 'Member end DOF', 'Symbol',
                'Base Beam Beta', 'Roof Beam Beta', 'Column Beta',
                'local x', 'local y', 'local z',
                'Vertical members'
            ],
            'Value': [
                '6.0 m', '8', '12',
                'lateral', 'vertical (up)', 'lateral',
                'pinned', '1, 2, 3, 4', 'UX, UY, UZ', 'RX, RY, RZ',
                '6', '48', '12', '36',
                '(node - 1) x 6 + 1..6', '1, 3, 5, 7', 'Pinned i and j', 'MZ',
                '8', '12 (12 per member)', 'hollow circle at the end',
                '0 deg', '0 deg', '90 deg',
                'start node i to end node j', 'in the vertical plane, upward',
                'completes the right-handed set',
                'local z parallel to global Z'
            ]
        }
        summary_df = pd.DataFrame(summary_data)
        summary_df.to_excel(writer, sheet_name='Model Data', index=False)
    
    file_path = os.path.abspath(filename)
    print(f"\n✅ Excel file created: {filename}")
    print(f"📁 Location: {file_path}")
    return file_path

def plot_structural_model(model):
    """Enhanced 3D plot with model data displayed on the side"""
    
    fig = plt.figure(figsize=(20, 14))
    ax = fig.add_subplot(111, projection='3d')
    
    # Color scheme
    colors = {
        'beam': '#1f77b4',
        'column': '#2ca02c',
        'released': '#ff7f0e',
        'nodes': '#d62728',
        'supports': '#2ca02c',
        'global_axes': '#000000',
        'local_axes': '#9467bd'
    }
    
    # Plot members
    for idx, member in enumerate(model.members):
        start = model.nodes[member[0]]
        end = model.nodes[member[1]]
        
        # Check if member has releases (pinned ends)
        has_release = idx in model.releases
        
        # Check if member is vertical (column)
        is_vertical = (start[0] == end[0] and start[2] == end[2])
        
        # Determine line style and color
        if is_vertical:
            line_color = colors['column']
            line_width = 3
            linestyle = '-'
        elif has_release:
            line_color = colors['released']
            line_width = 2.5
            linestyle = '--'
        else:
            line_color = colors['beam']
            line_width = 2
            linestyle = '-'
        
        # Draw member line
        ax.plot([start[0], end[0]], [start[1], end[1]], [start[2], end[2]],
               color=line_color, linewidth=line_width, linestyle=linestyle)
        
        # Draw pinned symbols at released ends (MZ release)
        if has_release:
            releases = model.releases[idx]
            # Start node release
            if 'MZ' in releases.get('start', []):
                draw_pinned_symbol(ax, start, end, 'start')
                # Add MZ label at start
                offset = 0.3
                dx = end[0] - start[0]
                dy = end[1] - start[1]
                dz = end[2] - start[2]
                length = sqrt(dx**2 + dy**2 + dz**2)
                if length > 0:
                    x = start[0] + (dx/length) * offset
                    y = start[1] + (dy/length) * offset + 0.3
                    z = start[2] + (dz/length) * offset
                    ax.text(x, y, z, '[MZ]', size=8, color='orange', weight='bold')
            
            # End node release
            if 'MZ' in releases.get('end', []):
                draw_pinned_symbol(ax, end, start, 'end')
                # Add MZ label at end
                offset = 0.3
                dx = start[0] - end[0]
                dy = start[1] - end[1]
                dz = start[2] - end[2]
                length = sqrt(dx**2 + dy**2 + dz**2)
                if length > 0:
                    x = end[0] + (dx/length) * offset
                    y = end[1] + (dy/length) * offset + 0.3
                    z = end[2] + (dz/length) * offset
                    ax.text(x, y, z, '[MZ]', size=8, color='orange', weight='bold')
        
        # Add member label (1-based)
        mid = [(start[0] + end[0]) / 2, (start[1] + end[1]) / 2, (start[2] + end[2]) / 2]
        # Offset label slightly for vertical members
        if is_vertical:
            mid[0] += 0.5
            mid[2] += 0.5
            # Add beta angle label for vertical members
            ax.text(mid[0], mid[1], mid[2], f'M{idx+1} [β={model.beta_angles[idx]:.0f}°]', 
                   size=9, color='black',
                   bbox=dict(boxstyle='round,pad=0.3', facecolor='white', alpha=0.8))
        else:
            # Check if member has release
            if has_release:
                ax.text(mid[0], mid[1], mid[2], f'M{idx+1} [MZ]', size=9, color='black',
                       bbox=dict(boxstyle='round,pad=0.3', facecolor='white', alpha=0.8))
            else:
                ax.text(mid[0], mid[1], mid[2], f'M{idx+1}', size=9, color='black',
                       bbox=dict(boxstyle='round,pad=0.3', facecolor='white', alpha=0.8))
        
        # Draw local axes for selected members
        if idx in [0, 4, 8, 9]:  # Show local axes on some members
            draw_local_axes(ax, start, end, model.beta_angles[idx])
    
    # Plot nodes and supports with DOF labels
    for i, node in enumerate(model.nodes):
        if i in model.supports:
            # Pinned support - draw triangle symbol
            draw_pinned_support(ax, node)
            # Node label with DOF range (1-based)
            dof_start = model.dof_labels[i]['UX']
            dof_end = model.dof_labels[i]['RZ']
            ax.text(node[0], node[1] - 0.7, node[2], 
                   f'N{i+1} (Pinned)\nDOF {dof_start}-{dof_end}', 
                   size=10, color='red', weight='bold',
                   ha='center', va='top')
        else:
            ax.scatter(node[0], node[1], node[2], color=colors['nodes'], s=100)
            # Node label with DOF range (1-based)
            dof_start = model.dof_labels[i]['UX']
            dof_end = model.dof_labels[i]['RZ']
            ax.text(node[0], node[1] + 0.4, node[2], 
                   f'N{i+1}\nDOF {dof_start}-{dof_end}', 
                   size=10, color='black', weight='bold',
                   ha='center', va='bottom')
    
    # Draw global axes
    draw_global_axes(ax)
    
    # Set labels and title
    ax.set_xlabel('X (Global) - m', fontsize=12, fontweight='bold')
    ax.set_ylabel('Y (Global Vertical) - m', fontsize=12, fontweight='bold')
    ax.set_zlabel('Z (Global) - m', fontsize=12, fontweight='bold')
    ax.set_title('6m x 6m x 6m Cube - Structural Model (Rev. 2)\n'
                'Pinned Supports | MZ Beam Releases | Beta Angles | DOF Labels',
                fontsize=14, fontweight='bold')
    
    # Set equal aspect ratio with some margin
    max_range = 6
    margin = 3
    mid = [3, 3, 3]
    ax.set_xlim(mid[0] - max_range/2 - margin, mid[0] + max_range/2 + margin)
    ax.set_ylim(mid[1] - max_range/2 - margin, mid[1] + max_range/2 + margin)
    ax.set_zlim(mid[2] - max_range/2 - margin, mid[2] + max_range/2 + margin)
    
    ax.grid(True, alpha=0.3)
    
    # Add model data as text on the side
    model_data_text = get_model_data_text(model)
    
    # Position the text on the right side of the plot
    # Using text2D for fixed position in figure coordinates
    ax.text2D(0.75, 0.98, model_data_text, transform=ax.transAxes,
             fontsize=9, verticalalignment='top',
             bbox=dict(boxstyle='round,pad=0.5', facecolor='white', 
                      edgecolor='black', alpha=0.95),
             family='monospace')
    
    # Add legend in the upper left
    from matplotlib.patches import Patch
    legend_elements = [
        Patch(facecolor=colors['beam'], edgecolor=colors['beam'], 
              label='Beam'),
        Patch(facecolor=colors['released'], edgecolor=colors['released'],
              label='Pinned member end (MZ released)'),
        Patch(facecolor=colors['column'], edgecolor=colors['column'],
              label='Column'),
        Patch(facecolor=colors['supports'], edgecolor=colors['supports'],
              label='Supported node (pinned)'),
        Patch(facecolor=colors['nodes'], edgecolor=colors['nodes'],
              label='Free node'),
        Patch(facecolor=colors['local_axes'], edgecolor=colors['local_axes'],
              label='Local axes')
    ]
    ax.legend(handles=legend_elements, loc='upper left', fontsize=9)
    
    plt.tight_layout()
    plt.show()

