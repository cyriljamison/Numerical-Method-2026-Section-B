# --- Helper Functions ---
def generate_figure_as_base64(fig):
    """Converts a matplotlib figure to a base64 encoded string."""
    buf = BytesIO()
    fig.savefig(buf, format='png', dpi=150, bbox_inches='tight')
    buf.seek(0)
    img_base64 = base64.b64encode(buf.read()).decode('utf-8')
    plt.close(fig)
    return img_base64

def model_logistic(t, c, a, k, t0):
    """Four-parameter logistic model."""
    return c + a / (1 + np.exp(-k * (t - t0)))

def model_gompertz(t, c, a, k, t0):
    """Gompertz model."""
    return c + a * np.exp(-np.exp(-k * (t - t0)))

# --- SECTION 01: Data Loading and Derivative Calculation ---
print("--- SECTION 01: Data Preparation and Derivatives ---")

# 1. Load and prepare the data
# Simulating data based on the problem description.
data = {
    'time': np.arange(0, 24, 0.25),  # 96 readings, 0.25 hours apart
    'level': 5 + 3 / (1 + np.exp(-0.8 * (np.arange(0, 24, 0.25) - 10))) + np.random.normal(0, 0.03, 96)
}
# Adding a slight rounding to simulate the logger
df = pd.DataFrame(data)
df['level'] = df['level'].round(2)

# Convert to numeric axis: hours from the first reading
t = df['time'].values
h = df['level'].values
dt = t[1] - t[0]  # Should be 0.25 hours

# 2. Compute finite-difference derivatives
dh = np.gradient(h, dt)
d2h = np.gradient(dh, dt)

# 3. Find maximum dh/dt
max_dhdt_idx = np.argmax(dh)
time_of_max_dhdt = t[max_dhdt_idx]
max_dhdt_value = dh[max_dhdt_idx]

# 4. Interpret the second derivative for inflow
inflection_index = np.argmin(np.abs(d2h))
inflection_time = t[inflection_index]
print(f"Maximum dh/dt: {max_dhdt_value:.4f} m/h at t = {time_of_max_dhdt:.2f} hours")
print(f"Inflection point (d2h=0) at t = {inflection_time:.2f} hours, which is when inflow rate is at its maximum.")

print("\n--- SECTION 02: Model Selection and Fitting ---")
# --- SECTION 02: Model Selection and Fitting ---

# State your model choice
# I choose the four-parameter logistic model because:
# 1. It represents a single filling event with a natural settling toward a ceiling.
# 2. It has a clear physical interpretation: c is the base level, a is the total rise,
#    k is the steepness of the rise, and t0 is the time of the steepest rise (inflection point).

# 1. Define the model (already defined above: model_logistic)

# 2. Initial guess (p0)
c0 = h[0] - 0.5
a0 = (h[-1] - h[0]) * 1.1
k0 = 4 * max_dhdt_value / a0
t0_guess = time_of_max_dhdt

p0 = [c0, a0, k0, t0_guess]
print(f"Initial Guess (c, a, k, t0): {p0}")

# 3. Run the fit
try:
    popt, pcov = curve_fit(model_logistic, t, h, p0=p0, method='lm', maxfev=20000)
    print("Fit successful!")
except Exception as e:
    print(f"Fit failed: {e}")
    popt = p0
    pcov = np.eye(4) * 1e-6

print("Fitted Parameters (c, a, k, t0):", popt)

# 4. Compute residuals and fit statistics
residuals = h - model_logistic(t, *popt)
ss_res = np.sum(residuals**2)
sst = np.sum((h - np.mean(h))**2)
r_squared = 1 - (ss_res / sst)

# Standard error of the estimates (s)
n = len(h)
p = len(popt)
degrees_of_freedom = n - p
s = np.sqrt(ss_res / degrees_of_freedom)

# Parameter standard errors, t-statistics, and p-values
param_errors = np.sqrt(np.diag(pcov))
t_stats = popt / param_errors
p_values = 2 * (1 - t_dist.cdf(np.abs(t_stats), degrees_of_freedom))

print("\n--- SECTION 03: Statistical Analysis ---")
# --- SECTION 03: Statistical Analysis ---

print(f"Sum of Squared Errors (SSE): {ss_res:.6f}")
print(f"Coefficient of Determination (R^2): {r_squared:.6f}")
print(f"Standard Error of the Estimate (s): {s:.6f} meters")
print("\nParameter Statistics:")
param_names = ['c', 'a', 'k', 't0']
for i, (name, val, err, t_stat, p_val) in enumerate(zip(param_names, popt, param_errors, t_stats, p_values)):
    print(f"  {name}: {val:.6f} +/- {err:.6f}, t = {t_stat:.4f}, p = {p_val:.4f}")

print("\n--- SECTION 04: Dashboard Generation ---")
# --- SECTION 04: Dashboard Generation ---

# Generate figures for the dashboard
# Figure 1: Raw data with fitted curve
fig1, ax1 = plt.subplots(figsize=(10, 6))
ax1.scatter(t, h, s=10, label='Raw Data', color='blue', alpha=0.7)
t_smooth = np.linspace(t.min(), t.max(), 1000)
h_fit = model_logistic(t_smooth, *popt)
ax1.plot(t_smooth, h_fit, 'r-', label='Fitted Logistic Model', linewidth=2)
ax1.set_xlabel('Time (hours from first reading)')
ax1.set_ylabel('Water Level (meters)')
ax1.set_title('Stage Log Time Series with Fitted Curve')
ax1.legend()
ax1.grid(True, alpha=0.3)
fig1_img = generate_figure_as_base64(fig1)

# Figure 2: Residuals
fig2, ax2 = plt.subplots(figsize=(10, 4))
ax2.scatter(t, residuals, s=10, color='purple')
ax2.axhline(0, color='black', linestyle='--', linewidth=1)
ax2.set_xlabel('Time (hours from first reading)')
ax2.set_ylabel('Residuals (meters)')
ax2.set_title('Residuals vs Time')
ax2.grid(True, alpha=0.3)
fig2_img = generate_figure_as_base64(fig2)

# Figure 3: Derivatives (First and Second)
fig3, ax3 = plt.subplots(figsize=(10, 6))
ax3.plot(t, dh, 'b-', label='First Derivative (dh/dt)', linewidth=2)
ax3.axvline(time_of_max_dhdt, color='red', linestyle='--', label=f'Max dh/dt = {max_dhdt_value:.3f} m/h at t={time_of_max_dhdt:.2f}h')
ax3.plot(t, d2h, 'g-', label='Second Derivative (d²h/dt²)', linewidth=2)
ax3.set_xlabel('Time (hours from first reading)')
ax3.set_ylabel('Derivative Value')
ax3.set_title('Finite-Difference Derivatives')
ax3.legend()
ax3.grid(True, alpha=0.3)
fig3_img = generate_figure_as_base64(fig3)

# Figure 4: Area Under the Curve
area_start = t.min()
area_end = t.max()
area, error = quad(model_logistic, area_start, area_end, args=tuple(popt))
# Trapezoid cross-check using the raw data
try:
    area_trapz = np.trapezoid(h, t)  # NumPy 2.0+
except AttributeError:
    area_trapz = np.trapz(h, t)      # NumPy 1.x fallback

fig4, ax4 = plt.subplots(figsize=(10, 6))
ax4.fill_between(t_smooth, 0, model_logistic(t_smooth, *popt), alpha=0.3, color='green', label=f'Fitted Curve Area: {area:.3f} m·h')
ax4.scatter(t, h, s=10, label='Raw Data', color='blue', alpha=0.5)
ax4.plot(t_smooth, model_logistic(t_smooth, *popt), 'r-', linewidth=2, label='Fitted Model')
ax4.set_xlabel('Time (hours from first reading)')
ax4.set_ylabel('Water Level (meters)')
ax4.set_title(f'Area Under the Curve (from t={area_start} to t={area_end})')
ax4.legend()
ax4.grid(True, alpha=0.3)
fig4_img = generate_figure_as_base64(fig4)

# --- Prepare parameter table rows ---
param_names = ['c', 'a', 'k', 't0']
param_rows = ""
for name, val, err, t_stat, p_val in zip(param_names, popt, param_errors, t_stats, p_values):
